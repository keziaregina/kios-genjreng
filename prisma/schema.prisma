generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  MERCHANT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(BUYER)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products       Product[]
  buyerOrders    Order[]    @relation("BuyerOrders")
  merchantOrders Order[]    @relation("MerchantOrders")
  cartItems      CartItem[]
  reviews        Review[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int
  image       String?
  weight      Int?
  // Buyers judge a guitar by its spec sheet, so the detail page reads these straight off the row.
  description String?
  warranty    String?
  material    String?
  rating      Float?
  reviewCount Int      @default(0)
  soldCount   Int      @default(0)
  stock       Int      @default(0)
  categoryId  Int
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]
  reviews    Review[]

  @@index([categoryId])
  @@index([userId])
}

// One order belongs to one seller, so a multi-merchant cart splits into several rows at checkout.
model Order {
  id         Int         @id @default(autoincrement())
  buyerId    Int
  merchantId Int
  status     OrderStatus @default(PENDING)
  total      Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  buyer    User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  merchant User        @relation("MerchantOrders", fields: [merchantId], references: [id])
  items    OrderItem[]
  reviews  Review[]

  @@index([buyerId])
  @@index([merchantId])
}

// Name and price are copied, not joined, so renaming or repricing a product never rewrites history.
model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  name      String
  price     Int
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// A review is proof of purchase, so it hangs off the order line it rates instead of the product alone.
model Review {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  buyerId   Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  buyer   User    @relation(fields: [buyerId], references: [id])

  @@unique([orderId, productId])
  @@index([productId])
  @@index([buyerId])
}

// Rows join the live product instead of copying it, because a cart is a wish list and an order is a receipt.
model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}
