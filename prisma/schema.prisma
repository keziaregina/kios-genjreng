generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  MERCHANT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  TRANSFER
  CARD
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(BUYER)
  // A store identity is separate from the personal name, so buyers see "GitarMurah_Semarang" instead of the merchant's real name.
  storeName    String?
  city         String?
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products       Product[]
  buyerOrders    Order[]             @relation("BuyerOrders")
  merchantOrders Order[]             @relation("MerchantOrders")
  cartItems      CartItem[]
  reviews        Review[]
  addresses      Address[]
  vouchers       Voucher[]
  redemptions    VoucherRedemption[]
  payments       Payment[]
}

// A buyer keeps several addresses but ships to one, so the chosen row is copied onto the order.
model Address {
  id         Int      @id @default(autoincrement())
  userId     Int
  label      String
  recipient  String
  phone      String
  street     String
  village    String
  district   String
  city       String
  postalCode String
  note       String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int
  image       String?
  weight      Int?
  // Buyers judge a guitar by its spec sheet, so the detail page reads these straight off the row.
  description String?
  warranty    String?
  material    String?
  color       String?
  rating      Float?
  reviewCount Int      @default(0)
  soldCount   Int      @default(0)
  stock       Int      @default(0)
  categoryId  Int
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  orderItems OrderItem[]
  cartItems  CartItem[]
  reviews    Review[]

  @@index([categoryId])
  @@index([userId])
}

// One order belongs to one seller, so a multi-merchant cart splits into several rows at checkout.
model Order {
  id         Int         @id @default(autoincrement())
  buyerId    Int
  merchantId Int
  status     OrderStatus @default(PENDING)
  subtotal   Int         @default(0)
  total      Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Shipping and payment are copied at checkout, so a later tariff or address edit never rewrites a receipt.
  shippingCourier String?
  shippingCost    Int           @default(0)
  shippingEta     String?
  protectionFee   Int           @default(0)
  discount        Int           @default(0)
  voucherCode     String?
  note            String?
  paymentMethod   PaymentMethod @default(COD)
  paymentId       Int?
  shipRecipient   String?
  shipPhone       String?
  shipAddress     String?

  buyer      User               @relation("BuyerOrders", fields: [buyerId], references: [id])
  merchant   User               @relation("MerchantOrders", fields: [merchantId], references: [id])
  payment    Payment?           @relation(fields: [paymentId], references: [id])
  items      OrderItem[]
  reviews    Review[]
  redemption VoucherRedemption?

  @@index([buyerId])
  @@index([merchantId])
  @@index([paymentId])
}

// One checkout splits into an Order per merchant but is paid once, so the Stripe intent hangs off its own row.
model Payment {
  id                      Int           @id @default(autoincrement())
  buyerId                 Int
  amount                  Int
  currency                String        @default("idr")
  status                  PaymentStatus @default(REQUIRES_PAYMENT)
  stripePaymentIntentId   String?       @unique
  stripeCheckoutSessionId String?       @unique
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  buyer  User    @relation(fields: [buyerId], references: [id])
  orders Order[]

  @@index([buyerId])
}

// Name and price are copied, not joined, so renaming or repricing a product never rewrites history.
model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  name      String
  price     Int
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// A review is proof of purchase, so it hangs off the order line it rates instead of the product alone.
model Review {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  buyerId   Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  buyer   User    @relation(fields: [buyerId], references: [id])

  @@unique([orderId, productId])
  @@index([productId])
  @@index([buyerId])
}

// Rows join the live product instead of copying it, because a cart is a wish list and an order is a receipt.
model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

// A voucher is scoped to the merchant who created it, so a code only ever discounts that seller's own Order.
model Voucher {
  id           Int          @id @default(autoincrement())
  userId       Int
  code         String
  discountType DiscountType
  amount       Int
  maxDiscount  Int?
  minPurchase  Int          @default(0)
  usageLimit   Int?
  usedCount    Int          @default(0)
  isActive     Boolean      @default(true)
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptions VoucherRedemption[]

  @@unique([userId, code])
  @@index([userId])
}

// usedCount is store-wide, so a per-buyer row is what stops one buyer redeeming the same code every checkout.
model VoucherRedemption {
  id        Int      @id @default(autoincrement())
  voucherId Int
  buyerId   Int
  orderId   Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([voucherId, buyerId])
  @@index([buyerId])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}
