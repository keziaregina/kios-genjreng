# Copy to .env and fill in. Every key here must also exist in Vercel > Settings > Environment Variables.

APP_NAME="Kios Genjreng"

# Neon pooled connection (host contains -pooler) — what the app queries through.
DATABASE_URL=""
# Neon direct connection (no -pooler) — migrations only; a pooler cannot run them.
DIRECT_URL=""

# Signs the session cookie; generate with `openssl rand -hex 32`.
SESSION_SECRET=""

# Server-side only, test mode — Stripe does not onboard Indonesian businesses for live payments.
STRIPE_SECRET_KEY=""
# From `stripe listen` locally, from the Dashboard endpoint in production — the two differ.
STRIPE_WEBHOOK_SECRET=""

# Vercel injects this once a Blob store is connected; locally use `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=""

DEEPSEEK_API_KEY=""
